# Copy this file to .env for local development.
# In Render, set these as real Environment Variables in the service dashboard —
# never commit an actual .env file.

ENVIRONMENT=development
DEBUG=true

# Neon connection string. Use the "pooled" connection string from the Neon
# dashboard for the app itself; sslmode=require is mandatory.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/portfolio?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_API_KEY=change-me-to-a-long-random-string

# Comma-separated, no trailing slashes
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_USE_TLS=true
OWNER_NOTIFICATION_EMAIL=you@example.com
CONTACT_FROM_EMAIL=no-reply@your-domain.com
EMAIL_ENABLED=true

CONTACT_RATE_LIMIT=5/hour
HONEYPOT_FIELD_NAME=website
